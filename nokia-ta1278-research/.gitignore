# Default deny: never add entire local acquisition/work directories.
/*
!/.gitignore
!/README.md
!/device-report.md
!/findings.md
!/research-log.md
!/sources.md
!/PUBLIC_SHA256SUMS
!/tools/
!/analysis/
!/firmware/

/tools/*
!/tools/*.py
!/tools/*.c
!/tools/*.S
!/tools/upstream-reference/
/tools/upstream-reference/*
!/tools/upstream-reference/mmi-framework/
/tools/upstream-reference/mmi-framework/*
!/tools/upstream-reference/mmi-framework/provenance.json

/firmware/*
!/firmware/README.md
!/firmware/public-system-manifest.json
!/firmware/original/
/firmware/original/*
!/firmware/original/bootrom-20261025T053201+0800.bin
!/firmware/original/system-20261025T054301+0800/
/firmware/original/system-20261025T054301+0800/*
!/firmware/original/system-20261025T054301+0800/boot0.bin
!/firmware/original/system-20261025T054301+0800/boot1.bin
!/firmware/original/system-20261025T054301+0800/kernel.bin
!/firmware/original/system-20261025T054301+0800/user.bin
!/firmware/original/system-20261025T054301+0800/mmi.bin

/analysis/*
!/analysis/*.md
!/analysis/system/
!/analysis/ui/
!/analysis/extracted/
/analysis/system/*
!/analysis/system/components.json
!/analysis/system/resource-index.json
!/analysis/system/resource-sections.json
!/analysis/system/resource-summary.json
!/analysis/system/keymap.json
!/analysis/system/abm-decode.json
/analysis/extracted/*
!/analysis/extracted/resources/
!/analysis/extracted/png/
!/analysis/extracted/kernel/
/analysis/extracted/kernel/*
!/analysis/extracted/kernel/keymap.bin
!/analysis/extracted/kernel/init_81c20000.bin
# Reproducible bulky/intermediate output, host command logs and local-only inventory.
/analysis/ui/framework-tree.json
/analysis/ui/user.analysis-only.elf
/analysis/ui/fonts/*-outlines.json
/analysis/ui/rebuild-log.json
/analysis/ui/code-analysis.json
/analysis/ui/original-integrity.json
